server:
  address: 'tcp://0.0.0.0:9091/'

log:
  level: info

storage:
  encryption_key: !file /secrets/storage_key
  local:
    path: /config/db.sqlite3

session:
  secret: !file /secrets/session_secret
  # not the default authelia_session: browsers still hold that one for the
  # bare courgettes.club (the old cookie domain) and send it alongside, which
  # makes Authelia read the stale session and loop back to the login page
  name: authelia_sso_session
  same_site: lax
  expiration: 1h
  inactivity: 5m
  # One cookie per scope, never the bare courgettes.club: a cookie is sent to
  # every host under its domain, and most of those (nextcloud, websites...)
  # have no business seeing an Authelia session.
  cookies:
    # public portal (users reset/change their password here) and any
    # protected app, as <app>.sso.courgettes.club (LLDAP's UI included)
    - domain: sso.courgettes.club
      authelia_url: 'https://sso.courgettes.club'

regulation:
  max_retries: 3
  find_time: 10m
  ban_time: 1h

authentication_backend:
  ldap:
    implementation: 'lldap'
    address: 'ldap://lldap:3890'
    base_dn: 'DC=courgettes,DC=club'
    user: 'UID=authelia,OU=people,DC=courgettes,DC=club'
    password: "{{ authelia_ldap_bind_password }}"

# Users set their own passwords through Authelia (reset by email, or change
# from the settings page), so this is the only place strength is enforced.
password_policy:
  zxcvbn:
    enabled: true
    min_score: 3

totp:
  issuer: courgettes.club
  period: 30
  skew: 1
  digits: 6
  algorithm: sha1

access_control:
  default_policy: deny
  rules:
    # LLDAP's UI is admin-only (and mesh-only, see Traefik's lldap router);
    # users manage their password through Authelia instead.
    - domain:
        - 'lldap.sso.courgettes.club'
      # TODO: back to two_factor once admin has an email (2FA enrolment
      # sends a one-time code to it)
      policy: one_factor
      subject:
        - "group:lldap_admin"

notifier:
  disable_startup_check: false
  smtp:
    address: 'smtp://mail.infomaniak.com'
    timeout: '5s'
    username: 'bot@courgettes.club'
    password: '{{ authelia_mail_password }}'
    sender: "Authelia <bot@courgettes.club>"
    identifier: 'localhost'
    subject: "[Authelia] {title}"
    startup_check_address: 'bot@courgettes.club'

identity_validation:
  reset_password:
    jwt_secret: !file /secrets/jwt_secret

# OIDC provider for NetBird. NetBird keeps its own embedded IdP (its owner
# account is the way in if this breaks); Authelia is added to it as a
# "Generic OIDC" connector in the NetBird dashboard, see install_netbird_server.
identity_providers:
  oidc:
    # both generated on the host and read back by the role (see tasks/main.yml)
    hmac_secret: '{{ authelia_oidc_hmac_secret }}'
    jwks:
      - key_id: 'main'
        algorithm: 'RS256'
        use: 'sig'
        key: |
          {{ authelia_oidc_jwks_key | indent(10) }}
    authorization_policies:
      netbird:
        default_policy: 'deny'
        rules:
          - policy: 'two_factor'
            subject: 'group:netbird_users'
    # NetBird's embedded IdP (Dex) fails on an ID token without `name`, and
    # Authelia only puts the bare minimum in it unless told otherwise.
    claims_policies:
      netbird:
        id_token:
          - 'email'
          - 'email_verified'
          - 'name'
          - 'preferred_username'
    clients:
      - client_id: 'netbird'
        client_name: 'NetBird'
        # pbkdf2 digest of the secret pasted into NetBird's connector form
        client_secret: '{{ authelia_oidc_netbird_client_secret_digest }}'
        public: false
        authorization_policy: 'netbird'
        claims_policy: 'netbird'
        redirect_uris: {{ netbird_oidc_redirect_uris | to_json }}
        scopes:
          - 'openid'
          - 'profile'
          - 'email'
          - 'groups'
        grant_types:
          - 'authorization_code'
        response_types:
          - 'code'
        # what Dex sends
        token_endpoint_auth_method: 'client_secret_basic'
