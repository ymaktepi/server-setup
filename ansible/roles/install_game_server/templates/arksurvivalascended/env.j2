# https://github.com/Acekorneya/Ark-Survival-Ascended-Server#environment-variables
INSTANCE_NAME=courgettes-club
TZ=Europe/Zurich

SESSION_NAME=courgettes.club
MAP_NAME=Ragnarok
SERVER_ADMIN_PASSWORD={{ ark_admin_password }}
SERVER_PASSWORD={{ ark_server_password }}
BATTLEYE=FALSE # this is what internet says
BATTLEEYE=FALSE # this is what the github readme says

# network
ASA_PORT=7777 # can conflict with satisfactory but necessary to run this retardosaurus game
RCON_ENABLED=TRUE
RCON_PORT=27020
MAX_PLAYERS=10

## mods - add it to the .env.local file maintained manually
# MOD_IDS=  # comma separated mod IDs
# PASSIVE_MODS=  # mod IDs that load without waiting on download

# updates
UPDATE_SERVER=TRUE
CHECK_FOR_UPDATE_INTERVAL=24
UPDATE_WINDOW_MINIMUM_TIME=3:00 AM
UPDATE_WINDOW_MAXIMUM_TIME=6:00 AM
RESTART_NOTICE_MINUTES=30
