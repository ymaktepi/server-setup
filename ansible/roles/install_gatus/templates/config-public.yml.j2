{#- Public instance (status.courgettes.club, via the DMZ Traefik): public
    sites + TeamSpeak, the physical machines and a few guests under public
    names (gatus_public_*). Internal addresses are hidden from the API/UI.
    No alerting (the internal instance does it). -#}
{%- macro ping(name, group, host) %}
  - name: "{{ name }}"
    group: {{ group }}
    url: "icmp://{{ host }}"
    interval: {{ gatus_interval }}
    conditions:
      - "[CONNECTED] == true"
    ui:
      hide-hostname: true
      hide-url: true
{%- endmacro -%}
{%- macro addr(m) -%}
{{ m.ip if m.ip is defined else hostvars[m.host]['ansible_host'] }}
{%- endmacro %}
storage:
  type: sqlite
  path: /data/data.db

ui:
  title: Courgettes Club status
  header: Courgettes Club

endpoints:
{% for c in gatus_web_checks['dmz'] | default([]) if not c.host.endswith('.local-dmz.courgettes.club') %}
  - name: "{{ c.host }}"
    group: sites
    url: "https://{{ c.host }}"
    interval: {{ gatus_interval }}
    client:
      timeout: 10s
    conditions:
      - "[STATUS] < 500"
{% endfor %}
{% for e in gatus_public_extra %}
  - name: "{{ e.name }}"
    group: sites
    url: "{{ e.url }}"
    interval: {{ gatus_interval }}
    conditions:
      - "[STATUS] < 500"
{% endfor %}
  - name: teamspeak
    group: sites
    url: "udp://{{ gatus_teamspeak.host }}:{{ gatus_teamspeak.port }}"
    interval: {{ gatus_interval }}
    # TS3 Init1 packet (header + step 0, zero timestamp/random), base64:
    # YAML string escapes are code points, they can't carry raw bytes
    body: !!binary VFMzSU5JVDEAZQAAiF1lNjAAAAAAAAAAAAAAAAAAAAAAAA==
    conditions:
      - "[CONNECTED] == true"
      - "[BODY] == pat(TS3INIT1*)"

  # infra
{{ ping('vps', 'infra', gatus_vps_host) }}
{% for m in gatus_public_machines if m.ip is defined or m.host in hostvars %}
{{ ping(m.name, 'infra', addr(m)) }}
{% endfor %}

  # guests
{% for m in gatus_public_guests if m.ip is defined or m.host in hostvars %}
{{ ping(m.name, 'guests', addr(m)) }}
{% endfor %}
