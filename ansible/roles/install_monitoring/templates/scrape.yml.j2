{#- `instance` is a host name rather than ip:port: the inventory name without
    its host_ prefix, or the Proxmox node name for nodes (same as the pve job).
    Not the VPS: unreachable from here (the CT isn't a NetBird peer). -#}
{%- macro host_name(h) -%}
{{ hostvars[h]['proxmox_node_name'] | default(h | regex_replace('^host_', '')) }}
{%- endmacro -%}
global:
  scrape_interval: {{ scrape_interval }}

scrape_configs:
  # node_exporter (install_node_exporter) on every home host
  - job_name: node
    static_configs:
{% for h in groups['debian'] | difference(groups['infomaniak']) | sort %}
      - targets: ["{{ hostvars[h]['ansible_host'] }}:9100"]
        labels: { instance: "{{ host_name(h) }}" }
{% endfor %}

  # Proxmox through the API (pve-exporter). Cluster-wide data (nodes,
  # guests, storage) is the same whichever node answers: every node is asked,
  # so it keeps coming while one is down, all under one `instance`, and
  # VictoriaMetrics' dedup (-dedup.minScrapeInterval) keeps a single copy.
  - job_name: pve_cluster
    metrics_path: /pve
    params:
      module: [default]
      cluster: ["1"]
      node: ["0"]
    static_configs:
{% for h in groups['pvenodes'] | sort %}
      - targets: ["{{ hostvars[h]['ansible_host'] }}"]
        labels: { instance: "cluster" }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: 127.0.0.1:9221

  # each node's own data (version, subscription, guest config)
  - job_name: pve_node
    metrics_path: /pve
    params:
      module: [default]
      cluster: ["0"]
      node: ["1"]
    static_configs:
{% for h in groups['pvenodes'] | sort %}
      - targets: ["{{ hostvars[h]['ansible_host'] }}"]
        labels: { instance: "{{ hostvars[h]['proxmox_node_name'] }}" }
{% endfor %}
    relabel_configs:
      - source_labels: [__address__]
        target_label: __param_target
      - target_label: __address__
        replacement: 127.0.0.1:9221

  # Traefik's `metrics` entrypoint (install_traefik_cts)
  - job_name: traefik
    static_configs:
{% for h in groups['traefik'] | sort %}
      - targets: ["{{ hostvars[h]['ansible_host'] }}:8082"]
        labels: { instance: "{{ host_name(h) }}" }
{% endfor %}

  # nvidia_gpu_exporter (install_gpu)
  - job_name: nvidia
    static_configs:
{% for h in groups['gpu'] | default([]) %}
      - targets: ["{{ hostvars[h]['ansible_host'] }}:9835"]
        labels: { instance: "{{ host_name(h) }}" }
{% endfor %}

{% if 'host_gatus' in hostvars %}
  # Gatus' /metrics (internal instance), behind the CT's nginx (self-signed)
  - job_name: gatus
    scheme: https
    tls_config:
      insecure_skip_verify: true
    static_configs:
      - targets: ["{{ hostvars['host_gatus']['ansible_host'] }}:443"]
        labels: { instance: "gatus" }

{% endif %}
  - job_name: victoriametrics
    static_configs:
      - targets: ["127.0.0.1:8428"]
        labels: { instance: "monitoring" }
