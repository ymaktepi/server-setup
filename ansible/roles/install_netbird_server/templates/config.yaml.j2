# Combined NetBird server: management, signal, relay, STUN and the embedded
# IdP. TLS ends at Traefik (install_traefik_cts, vps-config.yml).
server:
  listenAddress: ":80"
  exposedAddress: "https://{{ netbird_domain }}:443"
  stunPorts:
    - {{ netbird_stun_port }}
  metricsPort: 9090
  healthcheckAddress: ":9000"
  logLevel: "info"
  logFile: "console"

  authSecret: "{{ netbird_relay_auth_secret }}"
  dataDir: "/var/lib/netbird"

  auth:
    issuer: "https://{{ netbird_domain }}/oauth2"
    signKeyRefreshEnabled: true
    sessionCookieEncryptionKey: "{{ netbird_session_cookie_key }}"
    dashboardRedirectURIs:
      - "https://{{ netbird_domain }}/nb-auth"
      - "https://{{ netbird_domain }}/nb-silent-auth"
    cliRedirectURIs:
      - "http://localhost:53000/"
    # Local account, created on first startup only (changing these later has
    # no effect): the way in when Authelia (the Generic OIDC connector, see
    # tofu/netbird) is down. The password is a bcrypt hash, not the plaintext.
    owner:
      email: "{{ netbird_owner_email }}"
      password: "{{ netbird_owner_password_hash }}"

  reverseProxy:
    trustedHTTPProxies:
      - "{{ netbird_trusted_proxy }}"
    # defaults to 0.0.0.0/0, i.e. X-Forwarded-For trusted from anyone
    trustedPeers:
      - "{{ netbird_trusted_proxy }}"

  store:
    engine: "sqlite"
    # losing it makes the store unreadable: /opt/netbird/secrets is backed up
    # with /opt/netbird/data or not at all
    encryptionKey: "{{ netbird_store_encryption_key }}"
