#cloud-config
# Generated by tofu/modules/vms - first boot only (the VM ignores later
# changes to this file).
hostname: ${hostname}
fqdn: ${fqdn}
manage_etc_hosts: true

# renames the image's default user: keeps its passwordless sudo
user: ${user}
ssh_authorized_keys:
  - ${ssh_key}
disable_root: true
ssh_pwauth: false

timezone: ${timezone}
locale: ${locale}

package_update: true
package_upgrade: true
packages:
  - qemu-guest-agent

runcmd:
  - systemctl enable --now qemu-guest-agent
